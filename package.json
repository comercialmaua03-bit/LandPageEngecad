{
  "build": {
    "appId": "com.example.myapp",
    "productName": "AppIntro",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "author": "Maua",
  "description": "fullstack based on electron and vue",
  "name": "app-intro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "format": "prettier --write ./src",
    "electron": "electron ."
  },
  "dependencies": {
      "@fortawesome/fontawesome-free": "^7.2.0",
      "axios": "^1.13.5",
      "vue": "^3.5.24",
      "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
